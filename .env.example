# Azure RAG Agent POC - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Azure OpenAI
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# =============================================================================
# Azure AI Search
# =============================================================================
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX=rag-docs-index
# AZURE_SEARCH_API_KEY=  # Optional: Use Managed Identity instead

# =============================================================================
# Azure Cosmos DB (Optional - for conversation history)
# =============================================================================
COSMOS_DB_ENABLED=false
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_DATABASE=rag-conversations
AZURE_COSMOS_CONTAINER=conversations
# AZURE_COSMOS_CONNECTION_STRING=  # Optional: For local dev only

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Application Insights (D28 - OpenTelemetry Monitoring)
# =============================================================================
OTEL_ENABLED=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://japaneast-1.in.applicationinsights.azure.com/

# =============================================================================
# Azure Authentication (for local development)
# =============================================================================
# Option 1: Use Azure CLI (recommended for local dev)
#   Run: az login
#
# Option 2: Service Principal (for CI/CD)
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id
