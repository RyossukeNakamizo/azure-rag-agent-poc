# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX=rag-documents

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Azure Cosmos DB (D24追加)
COSMOS_DB_ENABLED=false
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=rag-conversations
AZURE_COSMOS_CONTAINER=conversations
# AZURE_COSMOS_CONNECTION_STRING=  # ローカル開発用（本番はManaged Identity）

# Azure Storage (Document Source)
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=documents

# Authentication Method
# Options: "managed_identity", "azure_cli", "service_principal"
AZURE_AUTH_METHOD=azure_cli

# Service Principal (if using)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# RAG Configuration
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
CHUNK_SIZE=500
CHUNK_OVERLAP=100
